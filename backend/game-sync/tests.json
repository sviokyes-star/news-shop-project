{
  "tests": [
    {
      "name": "Отказ без ключа",
      "method": "GET",
      "path": "/",
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Отказ с неверным ключом",
      "method": "GET",
      "path": "/?key=wrong_key_12345",
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Публичный статус доставки игрока",
      "method": "GET",
      "path": "/?action=status&steam_id=76561198000000000",
      "expectedStatus": 200,
      "expectedBody": {"pending_count": 0},
      "bodyMatcher": "partial"
    }
  ]
}