# Домен сайта (обязательно направь его A-записью на IP сервера)
DOMAIN=example.ru

# База данных. Пароль придумай длинный и случайный.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=appdb

# Имя схемы. Оставь как есть — так называется схема в текущей базе.
MAIN_DB_SCHEMA=t_p15345778_news_shop_project

# Хранилище файлов (логин/пароль придумай сам, минимум 8 символов)
AWS_ACCESS_KEY_ID=storageadmin
AWS_SECRET_ACCESS_KEY=CHANGE_ME_LONG_RANDOM

# Ключи интеграций — перенеси значения из настроек проекта на платформе
STEAM_API_KEY=
GAME_SYNC_KEY=
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
